[Install]
WantedBy=default.target

[Service]
Environment="APP_ENV=PROD"
WorkingDirectory=/home/entorb8/be/korrekturleser
# plain uvicorn (no gunicorn master saves ~35MB RAM); systemd restarts it after --limit-max-requests
ExecStart=/usr/bin/python3.14 -m uvicorn fastapi_app.main:app --host 0.0.0.0 --port 9002 --forwarded-allow-ips 127.0.0.1,::1 --limit-max-requests 100 --timeout-graceful-shutdown 30
Restart=always
RestartSec=5
