    "marked": "^18.0.7",
    "pinia": "^4.0.2",
    "quasar": "^2.23.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "workbox-window": "^7.4.1"
  },
  "browserslist": [
    "iOS >= 15",
    "Safari >= 15",
    "> 0.5%",
    "not dead"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@cspell/dict-de-de": "^4.1.2",
    "@hey-api/openapi-ts": "0.99.0",
