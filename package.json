    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/tsconfig": "^0.9.1",
    "cspell-cli": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-sonarjs": "^4.2.0",
